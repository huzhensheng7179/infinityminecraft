{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "infinitycraft:coin_smoke",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "infinitycraft:coin_shock"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.clamp(4.0 * v.radius, 8.0, 26.0)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "0.2 + 0.12 * v.radius",
				"direction": "outwards"
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.ratio = v.particle_age / v.particle_lifetime;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1.6, 2.8)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)",
				"rotation_rate": "math.random(-60, 60)"
			},
			"minecraft:particle_initial_speed": "0.8 + 1.6 * v.particle_random_2",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 0.9, 0],
				"linear_drag_coefficient": 2.2
			},
			"minecraft:particle_motion_collision": {
				"collision_drag": 0.4,
				"collision_radius": 0.15
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(0.7 + 0.7 * v.particle_random_1) * (0.35 + 0.65 * math.min(2.0 * v.ratio, 1.0)) * (0.6 + 0.12 * v.radius)",
					"(0.7 + 0.7 * v.particle_random_1) * (0.35 + 0.65 * math.min(2.0 * v.ratio, 1.0)) * (0.6 + 0.12 * v.radius)"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 32,
					"texture_height": 32,
					"uv": [0, 0],
					"uv_size": [32, 32]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.ratio",
					"gradient": {
						"0.0": "#CCDCECFF",
						"0.35": "#99B8D0F0",
						"0.7": "#558AA6CC",
						"1.0": "#006E8AB8"
					}
				}
			}
		}
	}
}
