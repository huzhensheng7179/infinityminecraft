{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "infinitycraft:coin_fire",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "infinitycraft:coin_glow"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.clamp(6.0 * v.radius, 10.0, 48.0)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_sphere": {
				"radius": "0.15 + 0.1 * v.radius",
				"direction": [
					"math.random(-6, 6)",
					"math.random(4, 12)",
					"math.random(-6, 6)"
				]
			},
			"minecraft:particle_initialization": {
				"per_render_expression": "v.ratio = v.particle_age / v.particle_lifetime;"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.6, 1.2)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)",
				"rotation_rate": "math.random(-90, 90)"
			},
			"minecraft:particle_initial_speed": "1.5 + 2.5 * v.particle_random_2",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 3.0, 0],
				"linear_drag_coefficient": 3.5
			},
			"minecraft:particle_appearance_billboard": {
				"size": [
					"(0.35 + 0.3 * v.particle_random_1) * (0.5 + 0.5 * math.sin(v.ratio * 180)) * (0.7 + 0.12 * v.radius)",
					"(0.35 + 0.3 * v.particle_random_1) * (0.5 + 0.5 * math.sin(v.ratio * 180)) * (0.7 + 0.12 * v.radius)"
				],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 64,
					"texture_height": 64,
					"uv": [0, 0],
					"uv_size": [64, 64]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.ratio",
					"gradient": {
						"0.0": "#FFFFFFFF",
						"0.2": "#FFBFE8FF",
						"0.5": "#FF4F8FFF",
						"0.8": "#FF2A4FCC",
						"1.0": "#001633A6"
					}
				}
			}
		}
	}
}
